while True:
    print("1. Check even/odd")
    print("2. Find Square")
    print("3. Find cube")
    print("4. Check positive/negative")
    print("5. Exit")
    choice = int(input("Enter choice: "))
    if choice == 5:
        print("Program Ended")
        break
    num = int(input("enter number: "))
    if choice == 1:
        if num%2 ==0:
            print("Even")
        else:
            print("Odd")
    elif choice == 2:
        print("Square: ", num*num)
    elif choice == 3:
        print("Cube: ", num*num*num)
    elif choice == 4:
        if num>0:
            print("Positive")
        else:
            print("Negative")